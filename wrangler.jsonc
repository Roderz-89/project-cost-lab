{
  "name": "projectcostlab",
  "compatibility_date": "2026-09-22",
  // Generated by scripts/build-static-config.mjs — do not edit by hand.
  // Static assets serve everything; _redirects + _headers + 404.html do routing and headers.
  // worker.js runs first ONLY on the canonical HTML page paths listed in run_worker_first, to replace
  // the CSP with the fixed policy + a per-request 'nonce-…' (lets Cloudflare's injected JS
  // Detections script run). www -> apex and http -> https are a dashboard Single Redirect rule.
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/","/about","/advertising","/contact","/cookies","/disclaimer","/guides/","/guides/boiler","/guides/boiler-vs-heat-pump","/guides/cost-per-square-metre","/guides/extension","/guides/loft","/guides/region-access","/guides/vat","/news","/privacy","/projects","/terms","/news/*","!/news/","!/news/index","!/news/*.html","!/news/*/","!/news/*/index","!/news/*/index.html","!/news/page/1"]
  },
  "workers_dev": false
}
