{
  "name": "projectcostlab",
  "compatibility_date": "2026-09-22",
  // Assets only: no Worker script runs per request. Redirects live in _redirects, headers + CSP in
  // _headers (both generated by scripts/build-static-config.mjs), the 404 page is 404.html.
  // www -> apex and http -> https are a Cloudflare dashboard Single Redirect rule + Always Use HTTPS.
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false
}
